{
  "name": "@cyient/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Default HTTP API client with error handling, authentication, and REST methods for Cyient DLM.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./dcr": "./src/types/dcr.ts",
    "./dn": "./src/types/dn.ts",
    "./cc": "./src/types/cc.ts",
    "./ecn": "./src/types/ecn.ts",
    "./mppl": "./src/types/mppl.ts",
    "./platform": "./src/types/platform.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cyient/shared-config": "workspace:*",
    "eslint": "^9.39.5",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
