{
  "name": "@cyient/shared-config",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript, ESLint, Vite and Vitest settings shared by every package and app.",
  "type": "module",
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./tsconfig.app.json": "./tsconfig.app.json",
    "./tsconfig.library.json": "./tsconfig.library.json",
    "./eslint": {
      "types": "./eslint.d.ts",
      "default": "./eslint.js"
    },
    "./vite": {
      "types": "./vite.d.ts",
      "default": "./vite.js"
    },
    "./vitest": {
      "types": "./vitest.d.ts",
      "default": "./vitest.js"
    },
    "./vitest-setup": "./vitest-setup.js"
  },
  "dependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@tanstack/eslint-plugin-query": "^5.105.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.72.1"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "eslint": "^9.39.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
