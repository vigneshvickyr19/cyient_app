# Document Change Request front end. Copy to .env.local for your machine, or set these for the build.
# Nothing here is secret: the Entra ID values are public identifiers.

# The DCR API: Docker and local runs use http://localhost:5555
VITE_API_BASE_URL=http://localhost:5555

# entra (Microsoft sign-in, the servers) or development (X-Dev-User header, Docker and local APIs only)
VITE_AUTH_MODE=development

# Entra ID, when VITE_AUTH_MODE=entra (see the backend's docs/SignIn.md)
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_SCOPE=api://cyient-dlm-dcr/access_as_user
VITE_ENTRA_REDIRECT_URI=

# The path the app is served under; email links use /dcr/requests/{id}
VITE_BASE_PATH=/dcr
