# Local development against the Docker or local Customer Complaint API (see .env.example). Override in .env.local.
# The app calls its own address; the dev server forwards /api to the real API (no CORS set-up needed on the API).
VITE_API_BASE_URL=http://localhost:4203
VITE_API_PROXY_TARGET=http://localhost:2222
VITE_AUTH_MODE=development
