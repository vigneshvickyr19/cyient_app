# Customer Complaint front end. Copy to .env.local for your machine, or set these for the build.
# Nothing here is secret: the Entra ID values are public identifiers.

# The Customer Complaint API: Docker and local runs use http://localhost:2222
VITE_API_BASE_URL=http://localhost:2222

# entra (Microsoft sign-in, the servers) or development (X-Dev-User header, Docker and local APIs only)
VITE_AUTH_MODE=development

# Entra ID, when VITE_AUTH_MODE=entra (see the backend's docs/SignIn.md)
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_SCOPE=api://cyient-dlm-cc/access_as_user
VITE_ENTRA_REDIRECT_URI=

# The path the app is served under; email links use /cc/complaints/{id}
VITE_BASE_PATH=/cc
